{
  "name": "youtube-tools",
  "description": "YouTube Tools",
  "repository": {
    "type": "git"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "lint": "eslint src/*.js src/*.jsx",
    "build": "npm run build:bundle && npm run build:background && npm run copy-css && npm run copy-css-icons",
    "build:bundle": "browserify src/app.js --extension=.jsx -o app/bundle.js -d -t [ babelify --presets [ @babel/preset-env @babel/preset-react ] ]",
    "build:background": "browserify src/background.js -o app/background.js -t [ babelify --presets [ @babel/preset-env @babel/preset-react ] ]",
    "watch": "npm run watch:bundle & npm run watch:background",
    "watch:bundle": "watchify src/app.js --extension=.jsx -o app/bundle.js -d -t [ babelify --presets [ @babel/preset-env @babel/preset-react ] ]",
    "watch:background": "watchify src/background.js -o app/background.js -t [ babelify --presets [ @babel/preset-env @babel/preset-react ] ]",
    "copy-css": "cp node_modules/bootstrap/dist/css/bootstrap*.min.css app/styles",
    "copy-css-icons": "cp node_modules/bootstrap-icons/font/bootstrap*-icons.min.css app/styles",
    "start": "webpack serve --mode development --open"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^10.0.0",
    "babel-preset-react": "^6.24.1",
    "babelify": "^10.0.0",
    "browserify": "^17.0.1",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.4",
    "grunt": "^1.6.1",
    "grunt-contrib-concat": "^2.1.0",
    "grunt-contrib-uglify": "^5.2.2",
    "html-webpack-plugin": "^5.6.3",
    "watchify": "^4.0.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "grunt-cli": "^1.5.0",
    "jquery": "^3.7.1",
    "natural-orderby": "^5.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-circular-progressbar": "^2.1.0",
    "react-dom": "^18.3.1",
    "react-router": "^7.4.0"
  }
}
